rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone can read products
    match /products/{id} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == "gawdeakshad@gmail.com";
    }

    // Users can read/write their own data or admins can access all
    match /users/{uid} {
      // Allow admin read/write
      allow read, write: if request.auth != null && request.auth.token.email == "gawdeakshad@gmail.com";

      // Allow user read/write their own profile
      allow read, write: if request.auth != null && (request.auth.uid == uid || request.auth.uid == resource.data.firebaseUid);

      // Allow anyone to query by email during login (for legacy login verification)
      allow read: if true;
    }

    // Users can read their own orders or admins can access all
    match /orders/{id} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || resource.data.firebaseUid == request.auth.uid || request.auth.token.email == "gawdeakshad@gmail.com");
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && request.auth.token.email == "gawdeakshad@gmail.com";
    }

    // Migration logs (admin only)
    match /migrationLogs/{document=**} {
      allow read, write: if request.auth != null && request.auth.token.email == "gawdeakshad@gmail.com";
    }
  }
}
